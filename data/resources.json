{
  "tableVersion": 1,
  "tiers": [
    { "id": 0, "name": "基质", "nameEn": "Substrate", "color": "#8a6d3b", "desc": "从土壤与矿脉中直接抽取的原始物质，浓度高、价值低、就地枯竭。" },
    { "id": 1, "name": "代谢", "nameEn": "Metabolite", "color": "#6fcf97", "desc": "菌丝代谢产物，几乎所有生产链的中枢；彼此可损耗互转，构成环。" },
    { "id": 2, "name": "共生", "nameEn": "Symbiotic", "color": "#fbbf24", "desc": "与地表生命交换而来的产物，是外交与经济系统的燃料。" },
    { "id": 3, "name": "特殊", "nameEn": "Exotic", "color": "#22d3ee", "desc": "需要特定拓扑布局与前置条件才能产出，进入中期成长的硬门槛。" },
    { "id": 4, "name": "世代", "nameEn": "Generational", "color": "#4ade80", "desc": "只有孢子化才能获得，跨世代保留，用于改写基因与开局规则。" },
    { "id": 5, "name": "法则", "nameEn": "Meta", "color": "#fde68a", "desc": "极端稀有。用途不是加成，而是直接改写游戏规则本身。" }
  ],
  "chains": [
    { "id": "decomposition", "name": "分解链", "desc": "腐殖质 → 糖 → 酶。增长快、投资周期短、收益稳定但会枯竭土壤。", "pace": "fast", "risk": "low" },
    { "id": "mineralization", "name": "矿化链", "desc": "矿质 → 晶格 → 核心。增长慢、投资周期极长、不可再生但抗枯竭。", "pace": "slow", "risk": "low" },
    { "id": "photosynthesis", "name": "光合链", "desc": "微光 + 水 → 糖 → 蜜露。受昼夜与季节调制，夜间停摆是主要风险。", "pace": "pulsed", "risk": "medium" },
    { "id": "reproduction", "name": "繁殖链", "desc": "孢子 → 扩张 → 基因。把资源转化为网络规模与世代货币。", "pace": "burst", "risk": "medium" },
    { "id": "defense", "name": "防御链", "desc": "毒素 → 抗性 → 寄生收益。高收益伴随敌意值与自伤，风险流的根基。", "pace": "gamble", "risk": "high" },
    { "id": "catalysis", "name": "催化链", "desc": "酶 → 级联 → 反应矩阵强化。爆发式增长，但要求复杂拓扑与持续酶消耗。", "pace": "exponential", "risk": "high" },
    { "id": "signal", "name": "信号链", "desc": "信息素 → 电信号 → 智慧。解锁自动化与规则引擎，依赖网络连通度。", "pace": "threshold", "risk": "low" },
    { "id": "covenant", "name": "契约链", "desc": "蜜露 → 契约点 → 基因片段。把产量转化为外交资本，受文明兴衰影响。", "pace": "volatile", "risk": "medium" },
    { "id": "meta", "name": "Meta 链", "desc": "星尘 → 生态法则碎片。只在挑战与隐藏内容中产出，用于改写规则。", "pace": "scarce", "risk": "none" },
    { "id": "hidden", "name": "隐藏链", "desc": "图鉴中不显示来源的资源。", "pace": "secret", "risk": "none" }
  ],
