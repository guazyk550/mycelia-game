{
  "tableVersion": 1,
  "evaluation": {
    "keyFormula": "catalystTagOf(upstreamNode) × classOf(downstreamNode)",
    "formula": "catalystMul = max(rateMul of matching in-links) × min(1 + 0.02 × (inDegree - 1), 1.2)",
    "enzymeMul": "1 - enzymeDiscount（对下游节点的 enzymePerSec 生效，多条入边取最小折扣）",
    "stabilityAdd": "stability 累加，用于抵消负面事件强度（0–1，上限 0.6）",
    "fallback": "先精确匹配 (upstreamTag, downstreamClass)，再匹配 (upstreamTag, \"*\")，最后 default",
    "notes": [
      "连线不只是管道：上游节点的 catalystTag 决定下游配方被如何催化。",
      "同样的节点集合，连线方式不同，产出可差 3–10 倍——这是拓扑流的核心收益来源。",
      "入边数量有边际收益（每多一条 +2%，上限 +20%），鼓励多源供给而不是单链堆叠。"
    ]
  },
  "default": {
    "rateMul": 1.0,
    "enzymeDiscount": 0.0,
    "stability": 0.0,
    "note": "无催化关系。资源照常流动，但没有任何增效。"
  },
