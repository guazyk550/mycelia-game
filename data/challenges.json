{
  "tableVersion": 1,
  "modifierKinds": [
    "richnessCap — 地块富饶度上限（百分点）",
    "banClass — 禁用某个节点类",
    "banResource — 禁用某个资源（产出与使用均被封锁）",
    "costGrowthAdd — 所有成本增长率 +N",
    "noAutomation — 自动化全部失效",
    "noOffline — 离线收益归零",
    "reverseRecipes — 配方输入输出互换",
    "resourceZero — 某个资源恒为 0 且不可生产",
    "randomRelink — 每 N 秒随机重连一条边",
    "marketClosed — 菌市关闭",
    "nodeDecay — 节点每秒有 N% 概率凋亡",
    "hostilityNoDecay — 敌意值永不衰减",
    "noLight — 光照类节点禁用且昼夜消失",
    "outputPenalty — 某资源产出惩罚（比例）",
    "toxinSelfDamageMul — 毒素自伤倍率",
    "timeLimitSec — 时限（秒），超时判定失败",
    "nodeCapMax — 节点总数上限",
    "linkCapMax — 连线总数上限",
    "eventRateMul — 事件频率倍率",
    "richnessFloorLow — 枯竭下限降低到 N%",
    "resourceTheft — 每秒有 N% 概率被偷走一部分资源",
    "matrixShuffle — 每 N 秒随机重排催化矩阵一条规则",
    "noCarryover — 孢子化不保留任何节点",
    "outDegreeMax — 每个节点出度上限",
    "depletionMul — 土壤损伤（抽枯竭）倍率",
    "layersOnly — 只允许在指定基质层建造（value 为层 id）",
    "noPrestige — 禁止孢子化",
    "buildSpeedMul — 建造速度倍率",
    "richnessSimmer — 土壤富饶度每秒小幅随机波动"
  ],
