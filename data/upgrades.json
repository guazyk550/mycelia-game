{
  "tableVersion": 1,
  "effectKinds": [
    "buildSpeed — 建造时间缩短（value 为折扣比例）",
    "outputMul — 产出倍率加成（value 为小数，0.25 = +25%；可用 node / res / class 之一作为过滤范围，全空则为全局）",
    "inputDiscount — 配方输入折扣（0–0.8）",
    "buildCostDiscount — 建造成本折扣",
    "catalystBonus — 催化倍率全局加成",
    "richnessRepair — 每秒土壤修复量（百分点）",
    "richnessFloor — 枯竭下限提升（百分点）",
    "richnessCap — 富饶度上限提升（比例，0.2 = +20%）",
    "depletionReduce — 采掘对土壤的伤害折扣",
    "offlineEfficiency — 离线效率加成",
    "critChance — 出芽暴击概率",
    "critMul — 暴击倍率",
    "linkFlux — 连线通量加成",
    "resourceCap — 资源上限加成",
    "prestigeGain — 孢子化收益加成",
    "eventResist — 事件强度减免",
    "marketFee — 市场手续费修正（负值为减免）",
    "autoTier — 解锁自动化层级（value 为目标层级）",
    "ruleSlot — 自动化规则槽 +N",
    "unlock — 解锁内容（value 为内容 id）",
    "depletionMul — 土壤枯竭速度倍率加成（value 为比例，1.2 = 枯竭快 120%）",
    "manualMul — 手动操作（连击）收益修正（负值为惩罚）",
    "costGrowthAdd — 节点成本增长率加值（0.03 = 增长率 +0.03）",
    "grantResource — 直接发放资源（value 为数量，res 指定资源；用于隐藏奖励）"
  ],
